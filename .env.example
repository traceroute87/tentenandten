# Copy to .env.local and fill in from your Supabase project settings → API.
# Without these, the app runs guest-only (local progress, no account/sync/referrals).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public Ko-fi support page (no payment processing happens inside the app).
VITE_SUPPORT_URL=https://ko-fi.com/tentenandten

# Temporary maintenance screen. Set to true to pause the public site; remove or set false to restore.
VITE_MAINTENANCE_MODE=
